# Ye file copy karke ".env" naam se save karo aur apni real API keys daalo.
# .env file kabhi GitHub pe upload mat karna (isliye .gitignore mein add karenge)

# NASA EONET ke liye DEMO_KEY se bhi kaam chal jata hai (rate-limited),
# lekin free key lena better hai: https://api.nasa.gov/
NASA_API_KEY=DEMO_KEY

# OpenWeatherMap free key: https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=your_openweathermap_key_here

# OpenAQ free API key (v3 se required hai): https://explore.openaq.org/register
OPENAQ_API_KEY=your_openaq_key_here

# Groq free API key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here
